{
  "server": {
    "port": 4001,
    "localOnly": true
  },
  "https": {
    "use": false,
    "keyPath": "/path/to/privkey.pem",
    "certPath": "/path/to/fullchain.pem"
  },
  "db": {
    "path": "~/paperless/paperless.sqlite",
    "busyTimeoutMs": 5000
  },
  "notebook": {
    "medicalNotebookName": "Medical",
    "medicalNotebookId": 0
  },
  "attachments": {
    "dir": "~/paperless/attachments"
  },
  "doctors": {
    "parentTagName": "medical/doctors",
    "photosDir": "~/paperless/doctor-photos"
  },
  "documents": {
    "documentTypeParentTagName": "medical/document-type",
    "specialtyParentTagName": "medical/specialty"
  },
  "mail": {
    "host": "smtp.example.com",
    "port": 587,
    "user": "REPLACE_ME",
    "pass": "REPLACE_ME",
    "from": "REPLACE_ME"
  },
  "reminders": {
    "timezone": "Asia/Jerusalem"
  },
  "auth": {
    "handler": "./auth/EmptyAuth.js",
    "devUserName": "user-one"
  },
  "security": {
    "allowList": {
      "user-one": { "locale": "en", "email": "REPLACE_ME", "personTagName": "REPLACE_ME" },
      "user-two": { "locale": "he", "email": "REPLACE_ME", "personTagName": "REPLACE_ME" }
    },
    "cookieSecret": "REPLACE_ME"
  },
  "i18n": {
    "fallbackLocale": "en",
    "supportedLocales": ["en", "he"]
  }
}
